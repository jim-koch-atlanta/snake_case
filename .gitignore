# Secrets / private league data (never commit)
.env
docs/league-config.toml
docs/player-notes.md

# Python bytecode
__pycache__/
*.pyc

# Tooling caches / venv (uv, pytest, ruff self-ignore too, but be explicit)
.venv/
.pytest_cache/
.ruff_cache/

# Third-party projection data is not ours to redistribute, and the ESPN
# snapshots/poller dumps are throwaway. Note this must be `data/*`, not
# `data/`: git cannot re-include a file whose parent directory is excluded,
# so excluding the contents is what makes the exception below work.
data/*
# ...except the crosswalk, which is hand-review effort over public player
# names, not league-private data. Losing it means redoing the review.
!data/crosswalk.csv
